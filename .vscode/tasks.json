{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync playground",
      "type": "process",
      "command": "uv",
      "args": [
        "--native-tls",
        "sync",
        "--locked",
        "--project",
        "${workspaceFolder}\\calliope-backend",
        "--extra",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
