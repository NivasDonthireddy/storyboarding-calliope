{
  "kind": "video",
  "prompt_node": "6",
  "prompt_input": "text",
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "cpu"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "wan2.2_vae.safetensors"}
    },
    "4": {
      "class_type": "ModelSamplingSD3",
      "inputs": {"model": ["1", 0], "shift": 8}
    },
    "5": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": ["3", 0],
        "width": 512,
        "height": 320,
        "length": 25,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "A red paper boat gently floats from left to right across calm blue water. Small ripples move around the boat. Locked camera, natural daylight."
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "static image, frozen motion, blurry, flicker, text, watermark, distorted shapes"
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0],
        "seed": 42,
        "steps": 20,
        "cfg": 5,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["3", 0]
      }
    },
    "10": {
      "class_type": "CreateVideo",
      "inputs": {"images": ["9", 0], "fps": 12}
    },
    "11": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["10", 0],
        "filename_prefix": "calliope-learning/video",
        "format": "mp4",
        "format.codec": "h264"
      }
    }
  }
}
